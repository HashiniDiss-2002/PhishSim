# Copy this file to .env and fill in real values, or export these
# as real environment variables before running the app.
# NEVER commit a real .env file to git.

FLASK_SECRET_KEY=change-this-to-a-long-random-string

# Required for real (non-mock) LLM pretext generation.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. If not set, emails are saved to outbox/*.html instead of sent.
# For safe testing, use Mailtrap (mailtrap.io) sandbox credentials here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=training@example.com
